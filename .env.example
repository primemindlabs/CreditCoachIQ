# ── Clerk (CreditCoachIQ's own auth — separate from conduit-next) ────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Supabase (CreditCoachIQ's own project — separate from conduit-next) ──────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (new, CreditCoachIQ-only billing account) ──────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Per-tier price IDs for the upgrade/downgrade flow (app/api/billing/change-tier).
STRIPE_PRICE_CREDIT_COACHING=
STRIPE_PRICE_WEALTH_COACHING=
STRIPE_PRICE_INVESTOR_PATH=

# ── Anthropic (AI dispute-letter / re-engagement drafting) ───────────────────
ANTHROPIC_API_KEY=

# ── Credit monitoring vendor webhook secrets (per-vendor, add as configured) ─
CREDITXPERT_WEBHOOK_SECRET=
FACTUAL_DATA_WEBHOOK_SECRET=
XACTUS_WEBHOOK_SECRET=
MERIDIANLINK_WEBHOOK_SECRET=
CREDIT_ALERTS_LIVE=false

# ── Optional: integration back to conduit-next (or any originating CRM) ──────
# Only needed if you want CreditCoachIQ to pull fresh borrower contact info
# from the CRM that originated the enrollment. Leave blank to run fully
# standalone (the CRM pushes borrower data at enroll time instead).
CONDUIT_API_BASE_URL=
CONDUIT_API_KEY=

# ── Funding-status sync FROM AshleyIQ/conduit-next (reverse of the Stage 4
# handoff — closes the loop once a loan progresses). Must match
# CREDIT_COACH_STATUS_SYNC_KEY in conduit-next's own .env. AshleyIQ (PrimeMind
# Labs) and CreditCoachIQ (EquityNest Capital) are separate companies — this
# is a cross-company shared secret, not an internal one.
CONDUIT_STATUS_SYNC_KEY=

# ── Messaging (visual campaign builder: email + SMS automation) ──────────────
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
NEXT_PUBLIC_APP_URL=

# ── Cron (send-queue processor + promo-expiring scan — Bearer auth) ──────────
CRON_SECRET=

# ── Lob (certified-mail dispute letter sending) ───────────────────────────────
# Unset = mock mode, the dispute send flow completes end-to-end without a
# live Lob account (useful for dev). Set for real certified mail.
LOB_API_KEY=

# ── Security: at-rest encryption key (AES-256-GCM) for EIN and any future
# SSN/account-number-class fields. 64 hex characters (32 bytes). Generate
# with: openssl rand -hex 32. If unset, a key is derived from
# SUPABASE_SERVICE_ROLE_KEY as a fallback — set this explicitly in
# production so key rotation isn't tied to your Supabase credentials.
ENCRYPTION_KEY=

# ── Plaid (bank-account linking for automated budget-transaction feed) ───────
# Unset = bank linking shows as unavailable in the portal (lib/plaid.ts
# isPlaidConfigured() gate) rather than a fake/mocked Link flow — a fake link
# token wouldn't actually render in Plaid's widget, so unlike Lob there's no
# safe mock mode here. See governance/VENDOR_RISK_REVIEW.md before enabling.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# ── Client portal: pre-call AI quiz + booking ─────────────────────────────────
# SmartCredit is just a referral link the client can click on their own —
# no API integration. Leave blank to omit the "pull your report" line from
# quiz-invite messages.
SMARTCREDIT_REFERRAL_URL=
# Calendly webhook signing key (Calendly account settings -> Integrations ->
# Webhooks). Required for app/api/webhooks/calendly to accept events.
CALENDLY_WEBHOOK_SIGNING_KEY=
